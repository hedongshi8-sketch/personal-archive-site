      "text": "weapons 定义局内武器构筑。 已接入 JSON。"
    },
    {
      "type": "paragraph",
      "text": "base_power, cooldown, tags"
    },
    {
      "type": "paragraph",
      "text": "chapter, room_index,"
    },
    {
